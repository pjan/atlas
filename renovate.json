{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Etc/UTC",
  "dependencyDashboard": true,
  "labels": ["dependencies", "docker"],
  "packageRules": [
    {
      "description": "Use SemVer for LinuxServer application images.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/lidarr",
        "lscr.io/linuxserver/bazarr",
        "lscr.io/linuxserver/qbittorrent",
        "lscr.io/linuxserver/speedtest-tracker"
      ],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for Gluetun.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["qmcgaw/gluetun"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for AdGuard Home.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["adguard/adguardhome"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for RoonServer.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/roonlabs/roonserver"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for Uptime Kuma.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["louislam/uptime-kuma"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for Seerr.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/seerr-team/seerr"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for qui.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/autobrr/qui"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for Rclone.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["rclone/rclone"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for Homepage.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/gethomepage/homepage"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for cloudflared.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cloudflare/cloudflared"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for Recyclarr.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["recyclarr/recyclarr"],
      "versioning": "semver"
    },
    {
      "description": "Use SemVer for FlareSolverr.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["flaresolverr/flaresolverr"],
      "versioning": "semver"
    },
    {
      "description": "Use LinuxServer Plex tag components for Plex Media Server.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/plex"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[a-z0-9]+-ls(?<revision>\\d+)$"
    },
    {
      "description": "Use LinuxServer SABnzbd tag components.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/sabnzbd"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "Group Komodo control-plane image updates together.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/moghtech/komodo-core",
        "ghcr.io/moghtech/komodo-periphery"
      ],
      "groupName": "komodo"
    }
  ]
}
