{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Etc/UTC",
  "dependencyDashboard": true,
  "labels": ["dependencies", "docker"],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "description": "Use stable SemVer for Docker images with standard version tags.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "adguard/adguardhome",
        "busybox",
        "caddy",
        "cloudflare/cloudflared",
        "flaresolverr/flaresolverr",
        "garethgeorge/backrest",
        "ghcr.io/autobrr/autobrr",
        "ghcr.io/autobrr/qui",
        "ghcr.io/av1155/houndarr",
        "ghcr.io/google/cadvisor",
        "ghcr.io/moghtech/komodo-core",
        "ghcr.io/moghtech/komodo-periphery",
        "ghcr.io/onedr0p/exportarr",
        "ghcr.io/roonlabs/roonserver",
        "ghcr.io/seerr-team/seerr",
        "golift/unpackerr",
        "grafana/grafana",
        "lscr.io/linuxserver/bazarr",
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/speedtest-tracker",
        "mongo",
        "mikefarah/yq",
        "mrusse08/soularr",
        "prom/alertmanager",
        "prom/blackbox-exporter",
        "prom/node-exporter",
        "prom/prometheus",
        "prometheuscommunity/json-exporter",
        "prometheuscommunity/smartctl-exporter",
        "qmcgaw/gluetun",
        "rclone/rclone",
        "recyclarr/recyclarr",
        "slskd/slskd",
        "spottarr/spottarr"
      ],
      "versioning": "semver",
      "ignoreUnstable": true
    },
    {
      "description": "Use upstream qBittorrent versions and exclude legacy LinuxServer tags.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "versioning": "regex:^(?<major>[0-9])\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Use Alpine release and package revision components for the rsync image.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["instrumentisto/rsync-ssh"],
      "versioning": "regex:^alpine(?<major>\\d+)\\.(?<minor>\\d+)-r(?<patch>\\d+)$"
    },
    {
      "description": "Use LinuxServer Lidarr tag components.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/lidarr"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "Use LinuxServer Plex tag components for Plex Media Server.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/plex"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[a-z0-9]+-ls(?<revision>\\d+)$"
    },
    {
      "description": "Use LinuxServer SABnzbd tag components.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/sabnzbd"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "Use LinuxServer Kometa tag components.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/kometa"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Automerge low-risk updates after validation.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Review every Alertmanager update: webhook payload templating is experimental, and a regression makes Discord reject every alert.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["prom/alertmanager"],
      "automerge": false
    },
    {
      "description": "Group Komodo control-plane image updates together.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/moghtech/komodo-core",
        "ghcr.io/moghtech/komodo-periphery"
      ],
      "groupName": "komodo"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned Atlas host filesystem utility image.",
      "managerFilePatterns": ["/^scripts\\/atlas-hostfs\\.sh$/"],
      "matchStrings": [
        "ATLAS_INIT_IMAGE='(?<depName>[^:']+):(?<currentValue>[^@']+)@(?<currentDigest>sha256:[a-f0-9]+)'"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the pinned yq image the repository validator reads YAML with.",
      "managerFilePatterns": ["/^scripts\\/validate-repository\\.py$/"],
      "matchStrings": [
        "YQ_IMAGE = \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the pinned Playwright image the manual Grafana theme probe runs in.",
      "managerFilePatterns": ["/^scripts\\/theme-probe\\.sh$/"],
      "matchStrings": [
        "PLAYWRIGHT_IMAGE='(?<depName>[^:']+):(?<currentValue>[^@']+)@(?<currentDigest>sha256:[a-f0-9]+)'"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
