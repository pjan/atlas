# authentik login, public only (PUBLIC_ONLY_CADDY_ROUTES; README "authentik").
# Cloudflare terminates HTTPS, so authentik is told the scheme is https (its
# OIDC URLs and secure cookies depend on it), and the client is the address
# Cloudflare saw (CF-Connecting-IP): authentik reads only X-Forwarded-For, which
# Caddy would otherwise set to the cloudflared container.
http://auth.atlas.vandaele.io {
	import atlas_hide_metrics
	reverse_proxy authentik-server:9000 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}
