http://caddy.atlas.local {
	header Content-Type text/html
	respond <<HTML
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Atlas Caddy</title>
	<style>
		:root {
			color-scheme: light;
			font-family: ui-sans-serif, system-ui, sans-serif;
			background: #101820;
			color: #f4f0e8;
		}

		body {
			margin: 0;
			min-height: 100vh;
			display: grid;
			place-items: center;
			background:
				radial-gradient(circle at 20% 20%, rgba(69, 142, 150, 0.35), transparent 32rem),
				linear-gradient(135deg, #101820 0%, #1f2a2e 52%, #3d3328 100%);
		}

		main {
			width: min(42rem, calc(100% - 2rem));
			padding: 2rem;
			border: 1px solid rgba(244, 240, 232, 0.18);
			border-radius: 1.25rem;
			background: rgba(16, 24, 32, 0.72);
			box-shadow: 0 1.5rem 5rem rgba(0, 0, 0, 0.3);
		}

		h1 {
			margin: 0 0 0.75rem;
			font-size: clamp(2rem, 7vw, 4rem);
			letter-spacing: -0.06em;
		}

		p {
			margin: 0;
			color: rgba(244, 240, 232, 0.76);
			font-size: 1.05rem;
			line-height: 1.6;
		}

		a {
			color: #8fd6c8;
			text-decoration: none;
		}
	</style>
</head>
<body>
	<main>
		<h1>Atlas Caddy</h1>
		<p>Caddy is running as the local reverse proxy for Atlas.</p>
	</main>
</body>
</html>
HTML 200
}
