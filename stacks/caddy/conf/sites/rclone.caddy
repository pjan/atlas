http://rclone.atlas.local {
	@rclone_root path /

	@rclone_api {
		path /config/*
		path /core/*
		path /job/*
		path /mount/*
		path /operations/*
		path /options/*
		path /rc/*
		path /serve/*
		path /sync/*
	}

	redir @rclone_root /login?url=http%3A%2F%2Frclone.atlas.local%2F 302

	handle @rclone_api {
		reverse_proxy rclone:5533
	}

	handle {
		reverse_proxy rclone:5522
	}
}
