http://rclone.atlas.local {
	basic_auth {
		{$RCLONE_BASIC_AUTH_USER} {$RCLONE_BASIC_AUTH_HASH}
	}

	@rclone_bootstrap `path('/') || (path('/login') && !query({'url': '*'}) )`

	@rclone_api {
		path /config/*
		path /core/*
		path /job/*
		path /mount/*
		path /operations/*
		path /options/*
		path /rc/*
		path /serve/*
		path /sync/*
	}

	handle @rclone_bootstrap {
		route {
			rewrite * /login
			uri query url http://rclone.atlas.local/
			redir {uri} 302
		}
	}

	handle @rclone_api {
		reverse_proxy rclone:5533
	}

	handle {
		reverse_proxy rclone:5522
	}
}
