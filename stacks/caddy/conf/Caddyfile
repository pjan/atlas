{
	metrics {
		per_host
	}
	# HTTPS for the LAN and Tailscale. No HTTP/3: UDP 443 is not published.
	servers :443 {
		protocols h1 h2
	}
	# The Cloudflare Tunnel's origin, reachable only on Docker networks. The
	# client is the address Cloudflare saw (CF-Connecting-IP).
	servers :8080 {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
}

# Owns the one *.atlas.vandaele.io certificate, which every site on :443 uses
# (Caddy issues no per-host certificates under a managed wildcard), and answers
# hostnames without a site. The DNS challenge's propagation check asks public
# resolvers, so Atlas' own DNS for *.atlas.vandaele.io cannot hide the record.
*.atlas.vandaele.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	respond 404
}

# Tunnel requests for a hostname without a site.
http://:8080 {
	respond 404
}

# Public hostnames never expose application metrics endpoints.
(atlas_hide_metrics) {
	@metrics path /metrics /metrics/* /prometheus /prometheus/*
	respond @metrics 404
}

(atlas_reverse_proxy) {
	http://{args[0]}.atlas.local {
		reverse_proxy {args[1]}
	}

	{args[0]}.atlas.vandaele.io, http://{args[0]}.atlas.vandaele.io, http://{args[0]}.atlas.vandaele.io:8080 {
		import atlas_hide_metrics
		reverse_proxy {args[1]}
	}
}

(atlas_rclone) {
	http://{args[0]}.atlas.local, {args[0]}.atlas.vandaele.io, http://{args[0]}.atlas.vandaele.io, http://{args[0]}.atlas.vandaele.io:8080 {
		@rclone_bootstrap `path('/') || (path('/login') && !query({'url': '*'}) )`

		handle @rclone_bootstrap {
			route {
				rewrite * /login
				uri query url http://{host}/api/
				redir {uri} 302
			}
		}

		handle_path /api/* {
			reverse_proxy {args[1]}
		}

		handle {
			reverse_proxy {args[2]}
		}
	}
}

import sites/*.caddy
