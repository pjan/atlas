# Komodo bootstrap environment for Atlas.
# Copy to .env on the NAS at /volume2/docker/komodo/.env and replace placeholders.

KOMODO_DATABASE_USERNAME=<mongo-root-username>
KOMODO_DATABASE_PASSWORD=<generate-random-secret>
KOMODO_INIT_ADMIN_PASSWORD=<generate-random-secret>
KOMODO_WEBHOOK_SECRET=<generate-random-secret>
KOMODO_JWT_SECRET=<generate-random-secret>

# Persistent NAS path for Komodo database backups.
COMPOSE_KOMODO_BACKUPS_PATH=/volume1/backups/komodo

# Must match the real checkout path on the NAS so Periphery can see managed repos/stacks.
PERIPHERY_ROOT_DIRECTORY=/volume2/docker/komodo
